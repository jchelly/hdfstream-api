<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>uk.ac.dur.cosma</groupId>
  <artifactId>hdfstream</artifactId>
  <packaging>war</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>HDFStream webapp</name>
  <url>https://github.com/jchelly/hdfstream</url>
  <dependencies>

    <!-- Junit for unit tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.13.3</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.13.3</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>5.13.3</version>
      <scope>test</scope>
    </dependency>

    <!-- Servlet API for tomcat 9 or earlier -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- Apache commons IO is used in tests and also to generate tar files -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.21.0</version>
    </dependency>

    <!-- Embedded tomcat, used to test servlets without running a full server -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-core</artifactId>
      <version>9.0.80</version>
      <scope>test</scope>
    </dependency>

    <!-- Messagepack library -->
    <dependency>
      <groupId>org.msgpack</groupId>
      <artifactId>msgpack-core</artifactId>
      <version>0.9.9</version>
    </dependency>

    <!-- Virtual directory library (from this repository) -->
    <dependency>
      <groupId>uk.ac.dur.cosma</groupId>
      <artifactId>virtual_directory</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <!-- JSTL tag library for jsp pages -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>jstl</artifactId>
      <version>1.2</version>
    </dependency>

    <!-- Apache http libraries for testing the server -->
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>4.5.14</version>
      <scope>test</scope>
    </dependency>

    <!--
        HDFStream library (also from this repository)
        Need to have installed the jar:

        mvn install:install-file -Dfile=HDFStream.jar -DgroupId=uk.ac.dur.cosma -DartifactId=libhdfstream -Dversion=1.0-SNAPSHOT -Dpackaging=jar
    -->
    <dependency>
      <groupId>uk.ac.dur.cosma</groupId>
      <artifactId>libhdfstream</artifactId>
      <version>1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <finalName>hdfstream</finalName>
    <plugins>
      <plugin>
        <!-- The Surefire plugin runs the unit tests in ./src/test/java/ -->
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <!-- Set location of libhdfstream_jni.so built by cmake -->
        <configuration>
          <argLine>-Djava.library.path=${project.build.directory}/../../jni/</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
        </configuration>
      </plugin>
      <!-- Use a newer than default compiler plugin to avoid java version issue -->
      <plugin>
	<groupId>org.apache.maven.plugins</groupId>
	<artifactId>maven-compiler-plugin</artifactId>
	<version>3.15.0</version>
      </plugin>
    </plugins>
  </build>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>

  <!-- When run by cmake we'd like to put all generated files under the cmake binary dir -->
  <profiles>
    <profile>
      <id>cmakeBuildDir</id>
      <activation>
        <property>
          <name>cmake.build.dir</name>
        </property>
      </activation>
      <build>
        <directory>${cmake.build.dir}</directory>
      </build>
    </profile>

    <!-- Profile to copy in configuration files -->
    <profile>
      <id>config</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-war-plugin</artifactId>
            <version>3.5.1</version>
            <configuration>
              <webResources>
                <resource>
                  <directory>${hdfstream.config.dir}</directory>
                  <targetPath>WEB-INF</targetPath>
                  <includes>
                    <include>web.xml</include>
                    <include>*.csv</include>
                    <include>*.csv.gz</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${hdfstream.config.dir}</directory>
                  <targetPath>META-INF</targetPath>
                  <includes>
                    <include>context.xml</include>
                  </includes>
                </resource>
              </webResources>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

</project>
